# ============================================================================
# SLIP Admin — 환경변수 예시
# 이 파일을 복사해 .env.local 을 만들고 실제 값으로 채우세요.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore 로 커밋되지 않습니다. 절대 실제 키를 커밋하지 마세요.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# 공개 프로젝트 URL (모바일 앱과 동일한 프로젝트).
NEXT_PUBLIC_SUPABASE_URL=https://joqjhufzozvncwmaijle.supabase.co

# service_role 시크릿 키 — 서버 사이드 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 발급: Supabase 대시보드 → Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- 관리자 인증 -----------------------------------------------------------
# 로그인 허용 이메일 목록 (쉼표로 구분, 대소문자 무시).
ADMIN_EMAILS=admin@example.com

# 공유 관리자 비밀번호.
ADMIN_PASSWORD=

# 세션 JWT 서명용 시크릿 (32자 이상 무작위 문자열).
# 예: openssl rand -base64 48
AUTH_SECRET=

# --- Azure Blob (선택: 영수증 이미지 표시) --------------------------------
# 세 값이 모두 있어야 이미지가 표시됩니다. 없으면 상세 페이지에서
# placeholder 박스와 안내 문구가 대신 표시됩니다(크래시 없음).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_BLOB_CONTAINER=receipts
